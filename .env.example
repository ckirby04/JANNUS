# JANNUS environment configuration — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials. If a key is ever
# committed or shared, rotate it rather than deleting the commit: assume
# anything that reached a remote has been captured.
#
# NOTE: none of these are required for the core validation workflow.
# `jannus validate-data`, `jannus predict` and `jannus evaluate` need no
# credentials and make no outbound network calls.

# ---------------------------------------------------------------------------
# API server (optional — only for `jannus.api`)
# ---------------------------------------------------------------------------

# Require an X-API-Key header. Defaults to true. Set to "false" ONLY on an
# isolated research machine; it disables authentication for every endpoint.
AUTH_REQUIRED=true

# Comma-separated allowed browser origins. Empty (the default) disables
# cross-origin access entirely. Never set this to "*" on a networked host.
# CORS_ORIGINS=https://viewer.hospital.example

# Bind address. Defaults to 127.0.0.1 (localhost only). Change to 0.0.0.0 only
# behind a reverse proxy that terminates TLS and performs authentication.
# JANNUS_HOST=127.0.0.1
# JANNUS_PORT=8000

# Audit/prediction database. Contains case identifiers — place it on encrypted
# storage covered by your site's PHI controls.
# DATABASE_PATH=/secure/path/jannus.db

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Salt for pseudonymising case identifiers in logs and reports. Set this to a
# site-specific secret so tokens cannot be correlated across sites. Keep it
# stable: changing it renames every case in future reports.
# JANNUS_LOG_SALT=change-me-to-something-random

# ---------------------------------------------------------------------------
# Training only
# ---------------------------------------------------------------------------

# Comma-separated case IDs to oversample during training.
# JANNUS_DIFFICULT_CASES=

# ---------------------------------------------------------------------------
# Literature retrieval (optional — `jannus[rag]` only)
#
# WARNING: report generation with these enabled transmits case context to a
# third-party API. Do not enable inside a hospital network without a Business
# Associate Agreement and IRB/privacy-office review.
# See docs/PHI_AND_DEIDENTIFICATION.md.
# ---------------------------------------------------------------------------

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# NCBI_EMAIL=
# NCBI_API_KEY=
